# Copy to .dev.vars and fill in values. Never commit .dev.vars.
MICROCMS_SERVICE_DOMAIN=your-service.microcms.io
MICROCMS_API_KEY=your-api-key
CONTENT_SOURCE=local

# 未設定なら src/config/domain.ts の本番既定値が使われる。
# ステージング等で切り替えたいときだけ指定する。
# PUBLIC_SITE_URL=https://toinoba.com
# PUBLIC_IMAGE_BASE=https://img.toinoba.com

# Cloudflare (sync-links / deploy)
# CLOUDFLARE_API_TOKEN=your-token
# KV_NAMESPACE_ID=your-kv-namespace-id

# Webhook proxy Worker (worker/webhook-proxy)
# MICROCMS_WEBHOOK_SECRET=your-webhook-secret
# GITHUB_DISPATCH_TOKEN=ghp_...
# GITHUB_REPO=owner/repo
