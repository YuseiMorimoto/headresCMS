---
import Seo from "../components/seo/Seo.astro";
import { SITE } from "../config/site";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: "website" | "article";
}

const { title, description, canonicalPath, noindex, ogImage, ogType } =
  Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <Seo
      title={title}
      description={description}
      canonicalPath={canonicalPath}
      noindex={noindex}
      ogImage={ogImage}
      ogType={ogType}
    />
    <slot name="head" />
  </head>
  <body class="bg-white text-gray-900">
    <header class="border-b border-gray-200">
      <div class="mx-auto flex max-w-3xl items-center justify-between px-4 py-4">
        <a href="/" class="text-lg font-bold">{SITE.name}</a>
        <nav class="text-sm text-gray-600">
          <a href="/about/" class="hover:underline">運営者情報</a>
        </nav>
      </div>
    </header>

    <main class="mx-auto max-w-3xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-12 border-t border-gray-200">
      <div class="mx-auto max-w-3xl px-4 py-6 text-sm text-gray-500">
        <p>&copy; {new Date().getFullYear()} {SITE.name}</p>
      </div>
    </footer>
  </body>
</html>
