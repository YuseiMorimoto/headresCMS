---
import "../styles/global.css";
import SeoHead from "@/components/seo/SeoHead.astro";
import type { BreadcrumbItem } from "@/lib/schema.ts";

type Props = {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: BreadcrumbItem[];
};

const {
  title,
  description,
  canonical,
  ogImage,
  noindex = false,
  jsonLd = [],
  breadcrumbs = [],
} = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImage}
      noindex={noindex}
      jsonLd={jsonLd}
    />
  </head>
  <body class="min-h-screen bg-white text-gray-900 antialiased">
    <header class="border-b border-gray-200">
      <div class="mx-auto flex max-w-4xl items-center justify-between px-4 py-4">
        <a href="/" class="text-lg font-bold text-gray-900 no-underline">
          サンプルアフィリエイトメディア
        </a>
        <nav class="flex gap-4 text-sm">
          <a href="/about/" class="text-gray-600 hover:text-gray-900">運営者情報</a>
          <a href="/contact/" class="text-gray-600 hover:text-gray-900">お問い合わせ</a>
        </nav>
      </div>
    </header>

    {
      breadcrumbs.length > 0 && (
        <nav aria-label="パンくず" class="mx-auto max-w-4xl px-4 py-3 text-sm text-gray-500">
          <ol class="flex flex-wrap gap-1">
            {breadcrumbs.map((item, i) => (
              <li class="flex items-center gap-1">
                {i > 0 && <span aria-hidden="true">›</span>}
                {i < breadcrumbs.length - 1 ? (
                  <a
                    href={item.url.startsWith("http") ? new URL(item.url).pathname : item.url}
                    class="hover:text-gray-900"
                  >
                    {item.name}
                  </a>
                ) : (
                  <span aria-current="page">{item.name}</span>
                )}
              </li>
            ))}
          </ol>
        </nav>
      )
    }

    <main class="mx-auto max-w-4xl px-4 py-8">
      <slot />
    </main>

    <footer class="mt-16 border-t border-gray-200 bg-gray-50">
      <div class="mx-auto flex max-w-4xl flex-wrap gap-4 px-4 py-8 text-sm text-gray-600">
        <a href="/about/">運営者情報</a>
        <a href="/privacy/">プライバシーポリシー</a>
        <a href="/disclaimer/">免責事項</a>
        <a href="/contact/">お問い合わせ</a>
      </div>
    </footer>
  </body>
</html>
