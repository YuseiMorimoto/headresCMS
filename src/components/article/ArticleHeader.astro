---
type Props = {
  title: string;
  publishedAt: Date;
  updatedAt: Date;
};

const { title, publishedAt, updatedAt } = Astro.props;
const date = publishedAt.toLocaleDateString("ja-JP");
const updated = updatedAt.toLocaleDateString("ja-JP");
---

<header class="mb-8">
  <h1 class="mb-4 text-3xl font-bold leading-tight">{title}</h1>
  <p class="text-sm text-gray-500">
    公開日: <time datetime={publishedAt.toISOString()}>{date}</time>
    {
      updatedAt > publishedAt && (
        <>
          {" "}
          / 更新日: <time datetime={updatedAt.toISOString()}>{updated}</time>
        </>
      )
    }
  </p>
</header>
