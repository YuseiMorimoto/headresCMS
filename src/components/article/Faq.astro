---
type FaqItem = {
  question: string;
  answer: string;
};

type Props = {
  items: FaqItem[];
};

const { items } = Astro.props;
---

{
  items.length > 0 && (
    <section class="my-10">
      <h2 class="mb-4 text-2xl font-bold">よくある質問</h2>
      <dl class="space-y-4">
        {items.map((item) => (
          <div class="rounded border border-gray-200 p-4">
            <dt class="mb-2 font-semibold">{item.question}</dt>
            <dd class="text-gray-700">{item.answer}</dd>
          </div>
        ))}
      </dl>
    </section>
  )
}
