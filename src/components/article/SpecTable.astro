---
type SpecItem = {
  label: string;
  value: string;
};

type Props = {
  items: SpecItem[];
};

const { items } = Astro.props;
---

<dl class="my-6 divide-y divide-gray-200 rounded border border-gray-200">
  {
    items.map((item) => (
      <div class="grid grid-cols-3 gap-2 px-4 py-3 sm:grid-cols-4">
        <dt class="col-span-1 font-semibold text-gray-700">{item.label}</dt>
        <dd class="col-span-2 text-gray-900 sm:col-span-3">{item.value}</dd>
      </div>
    ))
  }
</dl>
