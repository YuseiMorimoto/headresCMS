---
import BaseLayout from "../layouts/BaseLayout.astro";
import { SITE } from "../config/site";
---

<BaseLayout
  title={`ページが見つかりません | ${SITE.name}`}
  description="お探しのページは見つかりませんでした。"
  canonicalPath="/404"
  noindex={true}
>
  <h1 class="mb-4 text-2xl font-bold">ページが見つかりません</h1>
  <p class="mb-6">お探しのページは移動または削除された可能性があります。</p>
  <a href="/" class="text-blue-700 hover:underline">トップページへ戻る</a>
</BaseLayout>
